{
  "name": "@guyantools/ui-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    },
    "./components/*.js": {
      "types": "./dist/custom-elements/*.d.ts",
      "import": "./dist/custom-elements/*.js"
    },
    "./dist/custom-elements": {
      "types": "./dist/custom-elements/index.d.ts",
      "import": "./dist/custom-elements/index.js"
    },
    "./dist/custom-elements/*.js": {
      "types": "./dist/custom-elements/*.d.ts",
      "import": "./dist/custom-elements/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "stencil build && node scripts/copy-tokens.mjs && node scripts/create-entry.mjs",
    "typecheck": "stencil build --no-build",
    "test": "stencil-test --project spec",
    "verify:style-contract": "node scripts/assert-style-contract.mjs gt-button gt-icon-button gt-card gt-field gt-empty-state gt-state-card gt-input gt-textarea gt-checkbox gt-radio gt-switch gt-tabs gt-dialog gt-drawer gt-tooltip"
  },
  "devDependencies": {
    "@stencil/core": "^4.43.5",
    "@stencil/react-output-target": "^1.6.1",
    "@stencil/vitest": "^1.14.0",
    "@stencil/vue-output-target": "^0.14.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
