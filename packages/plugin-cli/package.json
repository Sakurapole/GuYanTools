{
  "name": "@guyantools/plugin-cli",
  "version": "1.0.0",
  "type": "module",
  "bin": { "guyantools-plugin": "./dist/index.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": { "build": "tsc --outDir dist && node -e \"require('node:fs').cpSync('src/templates','dist/templates',{recursive:true})\"", "prepack": "pnpm run build", "typecheck": "tsc --noEmit", "test": "vitest run" },
  "dependencies": { "@guyantools/plugin-vite": "workspace:^" },
  "devDependencies": { "@guyantools/plugin-sdk": "workspace:^", "@types/node": "^24.1.0", "typescript": "^5.8.3", "vitest": "^4.1.10" }
}
