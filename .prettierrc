{
    "semi": true,
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": ["*.css", "*.scss"],
            "options": {
                "printWidth": 100
            }
        },
        {
            "files": ["*.vue"],
            "options": {
                "parser": "vue",
                "singleAttributePerLine": false
            }
        }
    ]
}
