{
  "name": "@guyantools/plugin-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "@guyantools/ui-core": "workspace:*",
    "@stencil/react-output-target": "^1.6.1",
    "@stencil/vue-output-target": "^0.14.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "vue": ">=3.5.0"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist && node scripts/copy-tokens.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/node": "^24.1.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "typescript": "^5.8.3",
    "vue": "^3.5.13",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
